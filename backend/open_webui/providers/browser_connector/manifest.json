{
  "manifest_version": 3,
  "name": "DeepSeek Session Bridge — Cline + OWUI",
  "version": "1.1.0",
  "description": "Explicit DeepSeek session connection for Cline and OWUI in your existing browser profile.",
  "key": "",
  "permissions": [
    "cookies",
    "scripting",
    "nativeMessaging",
    "alarms",
    "storage"
  ],
  "host_permissions": [
    "https://chat.deepseek.com/*",
    "https://deepseek.com/*"
  ],
  "action": {
    "default_popup": "connect.html",
    "default_icon": {
      "16": "icons/disconnected-16.png",
      "32": "icons/disconnected-32.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "icons": {
    "16": "icons/disconnected-16.png",
    "32": "icons/disconnected-32.png"
  },
  "content_scripts": [
    {
      "matches": [
        "https://chat.deepseek.com/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_start",
      "all_frames": false
    }
  ]
}
