{
  "manifest_version": 3,
  "name": "OWUI DeepSeek account connector",
  "version": "1.0.0",
  "description": "Connect your DeepSeek session to your own local OWUI after explicit consent. Does not read passwords.",
  "key": "",
  "permissions": [
    "cookies",
    "webRequest",
    "storage"
  ],
  "host_permissions": [
    "https://chat.deepseek.com/*",
    "http://127.0.0.1/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://chat.deepseek.com/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_start",
      "all_frames": false
    }
  ]
}
