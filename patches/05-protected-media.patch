diff --git a/src/lib/components/common/ProtectedMedia.svelte b/src/lib/components/common/ProtectedMedia.svelte
new file mode 100644
index 0000000000000000000000000000000000000000..fa674f6778603032726248c7fa81a7b992ebd7c8
--- /dev/null
+++ b/src/lib/components/common/ProtectedMedia.svelte
@@ -0,0 +1,64 @@
+<script lang="ts">
+	import { onMount, onDestroy, getContext } from 'svelte';
+	import { user } from '$lib/stores';
+	import { protectedFileUrl, protectedFileBlob } from '$lib/utils/protectedFiles';
+	export let src = '';
+	export let kind: 'video' | 'audio' = 'video';
+	const i18n: any = getContext('i18n');
+	let mounted = false;
+	let resolved = '';
+	let error = '';
+	let controller: AbortController | undefined;
+	let objectUrl = '';
+	let generation = 0;
+
+	function release() {
+		controller?.abort();
+		if (objectUrl) URL.revokeObjectURL(objectUrl);
+		objectUrl = '';
+		resolved = '';
+	}
+
+	async function load(value: string, actor: string) {
+		const current = ++generation;
+		release();
+		error = '';
+		const file = protectedFileUrl(value, window.location.origin);
+		if (!file) {
+			try {
+				const url = new URL(value, window.location.origin);
+				if (!['http:', 'https:'].includes(url.protocol) || url.username || url.password) throw 0;
+				if (url.pathname.startsWith('/api/v1/files/')) throw 0;
+				resolved = url.href;
+			} catch { error = 'Invalid media URL'; }
+			return;
+		}
+		if (!actor) { error = 'Sign in to view this file'; return; }
+		controller = new AbortController();
+		try {
+			const { blob } = await protectedFileBlob(file, localStorage.getItem('token') ?? '', controller.signal);
+			if (current !== generation) return;
+			if (!blob.type.startsWith(kind + '/')) throw new Error('Unexpected media type');
+			objectUrl = URL.createObjectURL(blob);
+			resolved = objectUrl;
+		} catch (reason) {
+			if (current === generation && !controller?.signal.aborted) error = 'File unavailable or access denied';
+		}
+	}
+	onMount(() => { mounted = true; });
+	onDestroy(() => { generation++; release(); });
+	$: if (mounted) load(src, $user?.id ?? '');
+</script>
+
+{#if error}
+	<p role="status" class="text-sm text-gray-500">{$i18n.t(error)}</p>
+{:else if resolved}
+	{#if kind === 'video'}
+		<!-- svelte-ignore a11y-media-has-caption -->
+		<video class="w-full my-2" src={resolved} controls playsinline preload="metadata" title={$i18n.t('Video player')}></video>
+	{:else}
+		<audio class="w-full my-2" src={resolved} controls preload="metadata" title={$i18n.t('Audio player')}></audio>
+	{/if}
+{:else}
+	<p role="status" class="text-sm text-gray-500">{$i18n.t('Loading...')}</p>
+{/if}
diff --git a/src/lib/utils/marked/media-extension.ts b/src/lib/utils/marked/media-extension.ts
new file mode 100644
index 0000000000000000000000000000000000000000..dd39e195ffe87ac74aa8ee7afd14139dec8c5ae9
--- /dev/null
+++ b/src/lib/utils/marked/media-extension.ts
@@ -0,0 +1,18 @@
+import { mediaSource } from '../protectedFiles';
+
+// Marked otherwise splits single-line media into opening/text/closing tokens.
+// Keep a pair intact; HTMLToken still sanitizes it and applies URL/auth checks.
+export function mediaExtension(level: 'block' | 'inline') {
+	return {
+		name: level === 'block' ? 'pairedMediaBlock' : 'pairedMediaInline',
+		level,
+		start: (src: string) => level === 'block'
+			? src.search(/(?:^|\n)[ \t]{0,3}<(?:video|audio)\b/i)
+			: src.search(/<(?:video|audio)\b/i),
+		tokenizer(src: string) {
+			const match = src.match(/^<(video|audio)\b[^>]*>[\s\S]*?<\/\1>/i);
+			if (!match || !mediaSource(match[0], match[1].toLowerCase() as 'video' | 'audio')) return;
+			return { type: 'html', raw: match[0], text: match[0], block: level === 'block' };
+		}
+	};
+}
diff --git a/src/lib/utils/protectedFiles.test.ts b/src/lib/utils/protectedFiles.test.ts
new file mode 100644
index 0000000000000000000000000000000000000000..bc9c093bfa170d4afef6e2c90b6dc5aab55ae0cb
--- /dev/null
+++ b/src/lib/utils/protectedFiles.test.ts
@@ -0,0 +1,62 @@
+import { afterEach, describe, expect, it, vi } from 'vitest';
+import { mediaSource, protectedFileUrl, protectedFileBlob } from './protectedFiles';
+import { Marked } from 'marked';
+import { mediaExtension } from './marked/media-extension';
+
+const origin = 'http://localhost:8080';
+const path = '/api/v1/files/owned-file/content';
+afterEach(() => vi.unstubAllGlobals());
+
+describe('authenticated generated media', () => {
+	it('passes a complete token from the real lexer into the HTML renderer', () => {
+		const parser = new Marked({ extensions: [mediaExtension('block'), mediaExtension('inline')] });
+		for (const text of [`<video>${path}</video>`, `<video controls src="${path}"></video>`, `<audio>${path}</audio>`]) {
+			const tokens = parser.lexer(text+'\n\n');
+			expect(tokens[0].type).toBe('html');
+			expect((tokens[0] as any).text).toBe(text);
+		}
+		expect(parser.lexer('```html\n<video>'+path+'</video>\n```')[0].type).toBe('code');
+		const paragraph = parser.lexer('Video: <video>'+path+'</video>')[0] as any;
+		expect(paragraph.tokens.some((t: any) => t.type === 'html' && t.text.includes('</video>'))).toBe(true);
+	});
+	it('reads attribute, source-child and legacy inner-URL media', () => {
+		expect(mediaSource(`<video src="${path}"></video>`, 'video')).toBe(path);
+		expect(mediaSource(`<video>${path}</video>`, 'video')).toBe(path);
+		expect(mediaSource(`<video><source src="${path}"></video>`, 'video')).toBe(path);
+		expect(mediaSource(`<audio>${path}</audio>`, 'audio')).toBe(path);
+	});
+	it('allows only local file content URLs without credential parameters', () => {
+		expect(protectedFileUrl(path, origin)?.pathname).toBe(path);
+		for (const value of ['https://other.test'+path, 'http://user:pass@localhost:8080'+path,
+			path+'?token=private', '/api/v1/files/%2e%2e/content', 'javascript:alert(1)']) {
+			expect(protectedFileUrl(value, origin)).toBeNull();
+		}
+	});
+	it('uses a header and cookies, never a bearer in the URL', async () => {
+		vi.stubGlobal('window', { location: { origin } });
+		const request = vi.fn().mockResolvedValue(new Response('mp4', {
+			headers: { 'content-type':'video/mp4', 'content-disposition':"attachment; filename*=UTF-8''demo%20video.mp4" }
+		}));
+		vi.stubGlobal('fetch', request);
+		const result = await protectedFileBlob(new URL(path, origin), 'fixture-token');
+		expect(result.name).toBe('demo video.mp4');
+		expect(request.mock.calls[0][0]).toBe(origin+path);
+		expect(request.mock.calls[0][1]).toMatchObject({ headers: { Authorization:'Bearer fixture-token' }, credentials:'include', redirect:'error' });
+	});
+	it('does not send credentials outside the approved origin', async () => {
+		vi.stubGlobal('window', { location: { origin } });
+		const request = vi.fn(); vi.stubGlobal('fetch', request);
+		await expect(protectedFileBlob(new URL(path,'https://other.test'),'fixture-token')).rejects.toThrow('Invalid file URL');
+		expect(request).not.toHaveBeenCalled();
+	});
+	it('does not turn access denial into a playable blob', async () => {
+		vi.stubGlobal('window', { location: { origin } });
+		vi.stubGlobal('fetch', vi.fn().mockResolvedValue(new Response('denied',{status:403})));
+		await expect(protectedFileBlob(new URL(path,origin),'fixture-token')).rejects.toThrow('403');
+	});
+	it('rejects an oversized response before buffering it', async () => {
+		vi.stubGlobal('window', { location: { origin } });
+		vi.stubGlobal('fetch',vi.fn().mockResolvedValue(new Response('small',{headers:{'content-length':String(300*1024*1024)}})));
+		await expect(protectedFileBlob(new URL(path,origin),'fixture-token')).rejects.toThrow('size limit');
+	});
+});
diff --git a/src/lib/utils/protectedFiles.ts b/src/lib/utils/protectedFiles.ts
new file mode 100644
index 0000000000000000000000000000000000000000..5bcb3ccc10731796c271b3ee91085dff5bf693d8
--- /dev/null
+++ b/src/lib/utils/protectedFiles.ts
@@ -0,0 +1,54 @@
+// Protected file URLs stay token-free; credentials are sent only to this origin.
+export function protectedFileUrl(value: string, origin: string): URL | null {
+	try {
+		const base = new URL(origin);
+		const url = new URL(value, base);
+		if (url.origin !== base.origin || url.username || url.password || url.hash) return null;
+		if (!/^\/api\/v1\/files\/[A-Za-z0-9_-]+\/content$/.test(url.pathname)) return null;
+		if ([...url.searchParams.keys()].some((key) => key !== 'download')) return null;
+		return url;
+	} catch { return null; }
+}
+
+export function mediaSource(html: string, kind: 'video' | 'audio'): string {
+	const tag = html.match(new RegExp(`<${kind}\\b([^>]*)>([\\s\\S]*?)</${kind}>`, 'i'));
+	if (!tag) return '';
+	const attribute = tag[1].match(/\bsrc\s*=\s*["']([^"']+)["']/i);
+	const child = tag[2].match(/<source\b[^>]*\bsrc\s*=\s*["']([^"']+)["']/i);
+	return (attribute?.[1] ?? child?.[1] ?? tag[2].trim()).replaceAll('&amp;', '&');
+}
+
+export async function protectedFileBlob(url: URL, token: string, signal?: AbortSignal) {
+	if (!protectedFileUrl(url.href, window.location.origin)) throw new Error('Invalid file URL');
+	const response = await fetch(url.href, {
+		headers: token ? { Authorization: `Bearer ${token}` } : {},
+		credentials: 'include', redirect: 'error', cache: 'no-store', signal
+	});
+	if (!response.ok) throw new Error(`File HTTP ${response.status}`);
+	const limit = 256 * 1024 * 1024;
+	if (Number(response.headers.get('content-length')) > limit) {
+		await response.body?.cancel();
+		throw new Error('File exceeds preview size limit');
+	}
+	const blob = await response.blob();
+	if (blob.size > limit) throw new Error('File exceeds preview size limit');
+	const disposition = response.headers.get('content-disposition') ?? '';
+	let name = disposition.match(/filename\*=UTF-8''([^;]+)/i)?.[1] ??
+		disposition.match(/filename\s*=\s*"?([^";]+)/i)?.[1] ??
+		(blob.type.startsWith('video/') ? 'video.mp4' : 'download');
+	try { name = decodeURIComponent(name); } catch { /* Keep the original filename. */ }
+	name = name.replace(/[\\/\x00-\x1f]/g, '_').slice(0, 200);
+	return { blob, name };
+}
+
+export async function downloadProtectedFile(url: URL, token: string) {
+	const { blob, name } = await protectedFileBlob(url, token);
+	const objectUrl = URL.createObjectURL(blob);
+	const anchor = document.createElement('a');
+	anchor.href = objectUrl;
+	anchor.download = name;
+	document.body.appendChild(anchor);
+	anchor.click();
+	anchor.remove();
+	setTimeout(() => URL.revokeObjectURL(objectUrl), 60_000);
+}
