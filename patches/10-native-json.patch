diff --git a/.avx1/native_cache.py b/.avx1/native_cache.py
new file mode 100644
index 0000000000000000000000000000000000000000..ac213b7a73da9f347cd01ebfcd427783a05dfc5c
--- /dev/null
+++ b/.avx1/native_cache.py
@@ -0,0 +1,61 @@
+"""Exact native-only input cache; application changes do not impersonate native builds."""
+import hashlib
+import json
+import os
+from pathlib import Path
+import platform
+import shutil
+import sys
+import sysconfig
+import importlib.metadata
+from common import ROOT,sha256,run,write_json
+
+def toolchain():
+    packaging={}
+    for name in ('maturin','wheel','pip'):
+        try:packaging[name]=importlib.metadata.version(name)
+        except importlib.metadata.PackageNotFoundError:packaging[name]=None
+    return {'image':os.environ.get('ImageVersion',''),'rustc':run('rustc','-Vv',capture=True).stdout.strip(),
+            'packaging':packaging,
+            'python':sys.version,'abi':sysconfig.get_config_var('SOABI'),'machine':platform.machine(),
+            'windows_sdk':os.environ.get('WindowsSDKVersion',''),'vc_tools':os.environ.get('VCToolsVersion',''),
+            'environment':{key:os.environ.get(key,'') for key in ('RUSTFLAGS','CARGO_ENCODED_RUSTFLAGS','CARGO_PROFILE_RELEASE_LTO',
+                'CARGO_PROFILE_RELEASE_CODEGEN_UNITS','CARGO_PROFILE_RELEASE_OPT_LEVEL','CC','CXX','CFLAGS','CXXFLAGS','LDFLAGS')}}
+
+def signature(source,lto,flags,profile):
+    descriptor={'toolchain':toolchain(),'source_sha256':source,'lto':lto,'flags':flags,'profile':profile,
+                'recipes':{name:sha256(ROOT/'.avx1'/name) for name in ('native_json.py','native_cache.py','common.py','native-policy.json')}}
+    return hashlib.sha256(json.dumps(descriptor,sort_keys=True).encode()).hexdigest()
+
+def enabled():
+    # The hosted image identity pins its linker/SDK as well as Windows tools.
+    # Unknown/custom native wrappers must be freshly qualified instead.
+    return bool(os.environ.get('ImageVersion')) and not any(os.environ.get(key) for key in ('RUSTC_WRAPPER','RUSTC_WORKSPACE_WRAPPER','PYO3_CONFIG_FILE','CARGO_TARGET_X86_64_PC_WINDOWS_MSVC_LINKER'))
+
+def restore(destination,input_hash):
+    cache=ROOT/'.avx1-native-cache';receipt=cache/'receipt.json'
+    if not receipt.is_file() or cache.is_symlink():return None
+    value=json.loads(receipt.read_text('utf-8'))
+    if value.get('input_hash')!=input_hash:return None
+    for name,digest in value.get('files',{}).items():
+        if Path(name).name!=name or not (cache/name).is_file() or (cache/name).is_symlink() or sha256(cache/name)!=digest:return None
+    files=value.get('files',{})
+    if 'native-build.json' not in files or 'wheel.sha256' not in files or len([n for n in files if n.startswith('orjson-') and n.endswith('.whl')])!=1:return None
+    for name in files:shutil.copy2(cache/name,Path(destination)/name)
+    result=json.loads((cache/'native-build.json').read_text('utf-8'))
+    result.update(native_qualification_reuse=True,native_input_hash=input_hash)
+    write_json(Path(destination)/'native-build.json',result)
+    return result
+
+def store(destination,input_hash,wheel):
+    cache=ROOT/'.avx1-native-cache'
+    if cache.is_symlink():raise RuntimeError('Unsafe native cache directory')
+    cache.mkdir(exist_ok=True)
+    names=[wheel.name,'native-build.json','wheel.sha256']
+    for name in names:shutil.copy2(Path(destination)/name,cache/name)
+    write_json(cache/'receipt.json',{'input_hash':input_hash,'files':{name:sha256(cache/name) for name in names}})
+
+if __name__=='__main__':
+    descriptor=toolchain();key=hashlib.sha256(json.dumps(descriptor,sort_keys=True).encode()).hexdigest()
+    with Path(os.environ['GITHUB_OUTPUT']).open('a',encoding='utf-8') as output:
+        output.write('key='+key+'\ncacheable='+str(enabled()).lower()+'\n')
diff --git a/.avx1/native_json.py b/.avx1/native_json.py
new file mode 100644
index 0000000000000000000000000000000000000000..002f9d71a817749750afa4e0e52fe4e00cee1b7c
--- /dev/null
+++ b/.avx1/native_json.py
@@ -0,0 +1,76 @@
+"""Build orjson for Ivy Bridge with O3 and LTO or ThinLTO; no PGO."""
+from __future__ import annotations
+import argparse
+import json
+import os
+from pathlib import Path
+import sys
+import tarfile
+import tomllib
+import urllib.request
+
+from common import ROOT, WORK, download, run, sha256, write_json
+
+EXPERIMENTS = {
+    'ivy-o3-fat-cgu1': {'lto':'fat','opt':3,'codegen':1},
+    'ivy-o3-thin-cgu1': {'lto':'thin','opt':3,'codegen':1},
+    'ivy-o3-thin-cgu8': {'lto':'thin','opt':3,'codegen':8},
+    'ivy-o2-thin-cgu1': {'lto':'thin','opt':2,'codegen':1},
+}
+
+def build(destination, lto=None, experiment=None):
+    profile=EXPERIMENTS[experiment] if experiment else None
+    lto = profile['lto'] if profile else lto or os.environ.get("NATIVE_LTO", "fat")
+    if lto not in ("fat", "thin"):
+        raise ValueError("Expected fat or thin LTO")
+    destination = Path(destination)
+    destination.mkdir(parents=True, exist_ok=True)
+    dependencies = tomllib.loads((ROOT / "pyproject.toml").read_text("utf-8"))["project"]["dependencies"]
+    version = next(item.split("==")[1] for item in dependencies if item.startswith("orjson=="))
+    with urllib.request.urlopen(f"https://pypi.org/pypi/orjson/{version}/json", timeout=60) as response:
+        metadata = json.load(response)
+    source = next(item for item in metadata["urls"] if item["packagetype"] == "sdist")
+    archive = download(source["url"], WORK / "orjson.tar.gz", source["digests"]["sha256"])
+    source_root = WORK / ("native-source-" + lto)
+    source_root.mkdir(parents=True, exist_ok=True)
+    with tarfile.open(archive) as stream:
+        stream.extractall(source_root, filter="data")
+    checkout = next(path for path in source_root.iterdir() if path.is_dir())
+    run(sys.executable, "-m", "pip", "install", "maturin>=1.9,<2", "wheel")
+    base_flags = "-C target-cpu=ivybridge -C target-feature=+sse4.2,+avx,+f16c,+popcnt,-avx2,-fma -C opt-level=3 -C embed-bitcode=yes"
+    if profile:
+        base_flags = ("-C target-cpu=ivybridge -C target-feature=+sse4.2,+avx,+f16c,+popcnt,-avx2,-fma "
+                      f"-C opt-level={profile['opt']} -C embed-bitcode=yes")
+    from native_cache import enabled,signature,restore,store
+    cache_key=signature(sha256(archive),lto,base_flags,profile) if enabled() else None
+    if cache_key:
+        cached=restore(destination,cache_key)
+        if cached is not None:return cached
+    environment = dict(os.environ, CARGO_BUILD_JOBS="4", CARGO_INCREMENTAL="0", RUSTFLAGS=base_flags,
+                       CARGO_PROFILE_RELEASE_LTO=lto, CARGO_TARGET_DIR=str(WORK / ("cargo-" + lto)))
+    if profile:
+        environment.update(CARGO_PROFILE_RELEASE_CODEGEN_UNITS=str(profile['codegen']),
+                           CARGO_PROFILE_RELEASE_OPT_LEVEL=str(profile['opt']))
+    environment.pop("LLVM_PROFILE_FILE", None)
+    run(sys.executable, "-m", "pip", "wheel", "--no-deps", "--no-build-isolation", "--wheel-dir", destination,
+        checkout, env=environment)
+    wheel = next(Path(destination).glob("orjson*.whl"))
+    result = {"package": "orjson", "version": version, "source_sha256": sha256(archive),
+              "flags": base_flags, "pgo": False, "lto": lto, "wheel_sha256": sha256(wheel),
+              "rustc": run("rustc", "--version", capture=True).stdout.strip()}
+    if profile:result.update(experiment=experiment,codegen_units=profile['codegen'],opt_level=profile['opt'])
+    write_json(destination / "native-build.json", result)
+    (destination / "wheel.sha256").write_text(sha256(wheel) + "  " + wheel.name + "\n", encoding="utf-8")
+    if cache_key:
+        result.update(native_qualification_reuse=False,native_input_hash=cache_key)
+        write_json(destination/'native-build.json',result)
+        store(destination,cache_key,wheel)
+    return result
+
+
+if __name__ == "__main__":
+    parser = argparse.ArgumentParser()
+    parser.add_argument("--lto", choices=("fat", "thin"), default="fat")
+    parser.add_argument("--output", type=Path, required=True)
+    args = parser.parse_args()
+    build(args.output, args.lto)
