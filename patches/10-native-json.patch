+"""Differential native-wheel fixtures; no private data or model generation."""
+import base64
+import datetime as dt
+import json
+import orjson
+
+values=[None,False,True,0,-1,2**63-1,2**64-1,0.0,-0.0,5e-324,1.7976931348623157e308,
+        float('nan'),float('inf'),float('-inf'),'Привет 世界 😀',{'tool':'fixture','args':[None,True,1.25]},
+        dt.datetime(2026,10,23,7,0,tzinfo=dt.timezone(dt.timedelta(hours=6)))]
+results=[]
+for value in values:
+    try:results.append(['dump',base64.b64encode(orjson.dumps(value)).decode()])
+    except Exception as error:results.append(['dump-error',type(error).__name__])
+for value in [b'{"a":1,"b":[true,null]}',b'1e309',b'NaN',b'{"a":}',b'"\xed\xa0\x80"',b'['*1100+b'0'+b']'*1100]:
+    try:results.append(['load',json.dumps(orjson.loads(value),sort_keys=True,ensure_ascii=True)])
+    except Exception as error:results.append(['load-error',type(error).__name__])
+print(json.dumps(results,separators=(',',':')))
diff --git a/.avx1/test_native_cache.py b/.avx1/test_native_cache.py
new file mode 100644
index 0000000000000000000000000000000000000000..abbcac3ae65c395a6a3e2571be3f61a30a21607f
--- /dev/null
+++ b/.avx1/test_native_cache.py
@@ -0,0 +1,25 @@
+"""Never reuse an unmatching native input or corrupted cached wheel."""
+import json
+from pathlib import Path
+import tempfile
+import unittest
+from unittest.mock import patch
+import native_cache as cache
+from common import sha256,write_json
+
+class NativeCacheGates(unittest.TestCase):
+    def test_exact_cache_reuses_bytes_but_wrong_input_and_corruption_do_not(self):
+        with tempfile.TemporaryDirectory(prefix='native-cache-fixture-') as name:
+            root=Path(name);source=root/'produced';source.mkdir();destination=root/'restored';destination.mkdir()
+            wheel=source/'orjson-fixture.whl';wheel.write_bytes(b'fixture-native-binary')
+            write_json(source/'native-build.json',{'wheel_sha256':sha256(wheel),'pgo':False,'lto':'fat'})
+            (source/'wheel.sha256').write_text(sha256(wheel)+'  '+wheel.name)
+            with patch.object(cache,'ROOT',root):
+                cache.store(source,'input-a',wheel)
+                self.assertIsNone(cache.restore(destination,'input-b'))
+                result=cache.restore(destination,'input-a')
+                self.assertTrue(result['native_qualification_reuse']);self.assertEqual((destination/wheel.name).read_bytes(),wheel.read_bytes())
+                (root/'.avx1-native-cache'/wheel.name).write_bytes(b'corrupt')
+                self.assertIsNone(cache.restore(destination,'input-a'))
+
+if __name__=='__main__':unittest.main()
