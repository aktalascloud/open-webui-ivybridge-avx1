diff --git a/src/lib/utils/assistantCompatibility.js b/src/lib/utils/assistantCompatibility.js
new file mode 100644
index 0000000000000000000000000000000000000000..29f683ba56a2519dc34418ac11f5715480523393
--- /dev/null
+++ b/src/lib/utils/assistantCompatibility.js
@@ -0,0 +1,69 @@
+// Copyright (c) 2026 aktalascloud. Distributed under the repository license.
+/* assistant microphone input v1 */
+const __assistantMicOrigin = (() => {
+  const drafts = new WeakMap(), bound = new WeakSet();
+  const editor = (inputId = "chat-input") => document.getElementById(inputId);
+  const normal = value => String(value || "").replace(/\s+/g, " ").trim();
+  return {
+    clear(inputId) { const node = editor(inputId); if (node) drafts.delete(node); },
+    mark(text, inputId) {
+      const node = editor(inputId), draft = String(text || "");
+      if (!node || !draft.trim()) return;
+      drafts.set(node, draft);
+      if (bound.has(node)) return;
+      bound.add(node);
+      node.addEventListener("beforeinput", () => {
+        const selection = globalThis.getSelection();
+        const all = normal(node.innerText || node.textContent);
+        if (all && selection && !selection.isCollapsed &&
+            node.contains(selection.anchorNode) && node.contains(selection.focusNode) &&
+            normal(selection.toString()) === all) drafts.delete(node);
+      });
+      node.addEventListener("input", () => {
+        if (!normal(node.textContent)) drafts.delete(node);
+      });
+    },
+    change(text, inputId) {
+      const node = editor(inputId);
+      if (!node || !drafts.has(node)) return;
+      const draft = String(text || "");
+      if (draft.trim()) drafts.set(node, draft); else drafts.delete(node);
+    },
+    peek(text, inputId) {
+      const node = editor(inputId), draft = node && drafts.get(node);
+      const content = String(text || "");
+      if (!draft || (content !== draft && !content.startsWith(
+          draft + "\n\nSelected note text for replace_note_content operations:\n"))) return;
+      return {input_source: "microphone"};
+    }
+  };
+})();
+/* assistant voice budget v1 */
+const __assistantVoiceBudget = (() => {
+  const states = new Map();
+  const cost = text => String(text || "").length + 6 * (String(text || "").match(/\d/g) || []).length;
+  return {
+    start(id, rate=1) { rate=Number(rate); if(!Number.isFinite(rate)||rate<=0)rate=1; states.set(id, {prefix: [], pending: [], used: 0, rate:Math.min(1,rate)}); while (states.size > 8) states.delete(states.keys().next().value); },
+    hold(id, text) {
+      const state = states.get(id); if (!state) return false;
+      const report = /(?:1[сc]:|выручк|прибыл|отч[её]т|дебитор|остатки)/iu.test(text);
+      if (state.pending.length || report || state.used + cost(text) > 240*state.rate) { state.pending.push(text); return true; }
+      state.prefix.push(text); state.used += cost(text); return false;
+    },
+    finish(id, chat) {
+      const state = states.get(id); states.delete(id);
+      if (!state || !state.pending.length) return null;
+      return {text: state.pending.join(" "), options: {speech_message_id: id, speech_chat_id: chat,
+        speech_prefix: state.prefix.join(" "), speech_max_chars: Math.max(80, Math.floor(900*state.rate) - state.used)}};
+    },
+    emoji(text) {
+      const explicit = String(text || "").match(/[😀😃😄😁😆😂🤣😊🙂😉😇🥰😍🤩😔😞😟😥😢😭🥺🥹❤👍🎉]/u);
+      if (explicit) return explicit[0];
+      if (/(?:сожалению|жаль|сочувств|груст)/iu.test(text)) return "😔";
+      if (/(?:ура|отлично|спасибо|поздрав|получилось)/iu.test(text)) return "😊";
+      return /\?/.test(text) ? "🤔" : null;
+    }
+  };
+})();
+
+export { __assistantMicOrigin, __assistantVoiceBudget };
diff --git a/src/lib/utils/avatar-texture-loader.js b/src/lib/utils/avatar-texture-loader.js
new file mode 100644
index 0000000000000000000000000000000000000000..8d242ef212c65ac9606f41037cc2187901127655
--- /dev/null
+++ b/src/lib/utils/avatar-texture-loader.js
@@ -0,0 +1,20 @@
+// Preserve original VRM files; bound decoded GPU textures on each device.
+export function textureResizePlan(images,budget=32*1024*1024,maxEdge=4096) {
+  if(images.some(i=>!Number.isFinite(i.width)||!Number.isFinite(i.height)||i.width<1||i.height<1))throw Error('Invalid texture dimensions');
+  const total=images.reduce((sum,i)=>sum+i.width*i.height,0);
+  const scale=Math.min(1,Math.sqrt(budget/Math.max(1,total)));
+  return images.map(i=>{const s=Math.min(scale,maxEdge/Math.max(i.width,i.height));return {width:Math.max(1,Math.floor(i.width*s)),height:Math.max(1,Math.floor(i.height*s))};});
+}
+
+export function boundedBitmapLoader(images) {
+  const plans=textureResizePlan(images),bySize=new Map();
+  images.forEach((image,index)=>{const list=bySize.get(image.data.byteLength)||[];list.push({image,plan:plans[index]});bySize.set(image.data.byteLength,list);});
+  async function decode(url) {
+    if(!url.startsWith('blob:'))throw Error('External textures are blocked');
+    const response=await fetch(url),data=new Uint8Array(await response.arrayBuffer());
+    const item=(bySize.get(data.byteLength)||[]).find(({image})=>data.every((byte,index)=>byte===image.data[index]));
+    if(!item)throw Error('Texture was not validated');
+    return createImageBitmap(new Blob([data]),{resizeWidth:item.plan.width,resizeHeight:item.plan.height,resizeQuality:'high',premultiplyAlpha:'none',colorSpaceConversion:'none'});
+  }
+  return {isImageBitmapLoader:true,load(url,onLoad,_progress,onError){decode(url).then(onLoad,onError);}};
+}
