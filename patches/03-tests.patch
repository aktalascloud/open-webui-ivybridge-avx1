+def function(path,name,namespace,legacy=False):
+    tree=ast.parse((ROOT/path).read_text('utf-8'))
+    node=copy.deepcopy(next(n for n in ast.walk(tree) if isinstance(n,(ast.AsyncFunctionDef,ast.FunctionDef)) and n.name==name))
+    node.decorator_list=[];node.returns=None
+    for arg in [*node.args.posonlyargs,*node.args.args,*node.args.kwonlyargs]:arg.annotation=None
+    if legacy:
+        factory=ast.FunctionDef(name='factory',args=ast.arguments(posonlyargs=[],args=[],kwonlyargs=[],kw_defaults=[],defaults=[]),
+            body=[ast.Assign(targets=[ast.Name(id='skip_files',ctx=ast.Store())],value=ast.Constant(False)),node,ast.Return(ast.Name(id=name,ctx=ast.Load()))],decorator_list=[])
+        module=ast.Module(body=[factory],type_ignores=[])
+    else:module=ast.Module(body=[node],type_ignores=[])
+    exec(compile(ast.fix_missing_locations(module),str(path),'exec'),namespace)
+    return namespace['factory']() if legacy else namespace[name]
+
+def mcp_instance(session):
+    space={'AIOHTTP_CLIENT_TIMEOUT_TOOL_SERVER':None,'JSONCodec':json,'math':math,'ui_resource_uri':lambda _:None}
+    raw=function(Path('utils/mcp/client.py'),'call_tool_raw',space)
+    call=function(Path('utils/mcp/client.py'),'call_tool',space)
+    normalize=function(Path('utils/mcp/client.py'),'normalize_tool_result',space)
+    cls=type('ActualMCPAdapter',(),{'call_tool_raw':raw,'call_tool':call,'normalize_tool_result':staticmethod(normalize)})
+    instance=cls();instance.client=session;instance.tool_definitions={}
+    return instance
+
+
+def execution_scope(extra=None):
+    space={**runpy.run_path(str(ROOT/'utils/tool_calling.py')),'JSONCodec':json,'time':time,
+           'hashlib':hashlib,'re':re,'uuid4':uuid4,'is_saved_chat_id':lambda _:True}
+    space.update(extra or {})
+    for name in ['tool_permission_fingerprint','requires_tool_approval']:
+        function(Path('utils/tool_permissions.py'),name,space)
+    function(Path('utils/middleware.py'),'_is_tool_result_error',space)
+    function(Path('utils/middleware.py'),'execute_tool_call',space)
